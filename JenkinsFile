pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                git branch: 'main',
                    url: 'https://github.com/yanamandravenkataramakarthik23csm-stack/devops.git/t'
            }
        }

        stage('Build') {
            steps {
                echo 'Building the project...'
                sh './build.sh'   // or: mvn clean install / npm install
            }
        }

        stage('Test') {
            steps {
                echo 'Running tests...'
                sh './run-tests.sh'
            }
        }

        stage('Package') {
            steps {
                echo 'Packaging application...'
                sh './package.sh'
            }
        }

    }

    post {
        success {
            echo 'Build successful!'
        }
        failure {
            echo 'Build failed!'
        }
    }
}
